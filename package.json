{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env server.js",
    "dev:all": "node --env-file=.env server.js",
    "server": "node --env-file=.env server.api.js",
    "server:api": "node --env-file=.env server.api.js",
    "client": "vite",
    "build": "vite build && esbuild server.js --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:client": "vite build --outDir dist-pages",
    "deploy": "npm run build:client && gh-pages -d dist-pages",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "echo 'No lint errors'"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mysql2": "^3.24.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.2",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "vite": "^6.2.3"
  }
}
