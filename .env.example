# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MySQL Database Configuration
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD="123456"
MYSQL_DATABASE="vitaltrack_db"

# Deployment configuration (optional for local development)
JWT_SECRET="replace-with-a-long-random-secret"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"
MYSQL_SSL="false"
# For Aiven, paste the CA certificate as a multiline secret or with \n characters.
MYSQL_SSL_CA=""

# Frontend deployment configuration
VITE_API_URL="/api"
VITE_BASE_PATH="/"

# Health UX and optional AI explanation (never put provider secrets in VITE_*).
VITE_HEALTH_STALE_DAYS="7"
GEMINI_MODEL="gemini-2.5-flash"
# Development simulations stay OFF in production and should normally stay off locally.
ALLOW_DEMO_AUTH="false"
ALLOW_DEMO_DATA="false"
VITE_ENABLE_DEMO_AUTH="false"
